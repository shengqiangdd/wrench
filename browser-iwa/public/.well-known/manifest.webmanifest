{
  "name": "Wrench Browser SSH Preview",
  "short_name": "Wrench SSH Preview",
  "version": "0.1.0",
  "start_url": "/",
  "display": "standalone",
  "icons": [
    {
      "src": "/iwa-icon.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    }
  ],
  "permissions_policy": {
    "direct-sockets": [
      "self"
    ],
    "local-network": [
      "self"
    ],
    "cross-origin-isolated": [
      "self"
    ]
  }
}
