# Wrench Backend Configuration
# Copy this to .env and adjust values

# Server
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=3001
LOG_LEVEL=info

# CORS (comma-separated origins, empty = permissive)
CORS_ORIGINS=

# Frontend dist path (relative or absolute)
# In Docker: use /app/frontend/dist
FRONTEND_DIST=/app/frontend/dist

# Plugins directory
PLUGINS_DIR=./plugins

# JWT Secret (REQUIRED for production — generates random key if empty, which resets on restart)
# Generate a secure key: openssl rand -hex 32
# JWT_SECRET=

# 入口口令（可选，推荐留空）
# 留空时：首次访问网页会显示「首次设置」，用启动日志里的一次性 setup token 设置口令，
# 之后口令以 PBKDF2 哈希保存在数据库里（明文不落盘）。
#   docker logs <容器名> 2>&1 | grep -i "setup token"
# 设置该变量则以环境变量为准（legacy 部署平滑升级用）；改它会让所有旧令牌立即失效。
# 生成一个强密码：openssl rand -base64 32
# WRENCH_AUTH_PASSWORD=

# 也可用文件提供口令（优先级低于 WRENCH_AUTH_PASSWORD）
# WRENCH_AUTH_PASSWORD_FILE=/data/auth_password

# ⚠️ DATABASE_URL 是必需的：每个访客一个私有空间（数据按 space_id 隔离），
# 没有可用数据库时受保护接口一律返回 503（失败关闭），不会共享空间。
# Docker 下默认 /data/wrench.db

# ─── 出口策略：这台机器允许主动连到哪里 ───
# 逗号分隔的 IP[:端口] / CIDR[:端口]。留空 = 内网/环回/链路本地/云元数据地址一律拒绝。
# 越窄越安全：每个条目都等于「任何人打开网页后可以用来发起连接的目标」。
# WRENCH_EGRESS_ALLOW=192.168.1.5:22,192.168.1.6:22
# 置 1 时连公网目标也必须在白名单里（只管理固定几台主机时更严）
# WRENCH_EGRESS_STRICT=0

# ─── 反向代理 ───
# 反向代理的地址/网段（逗号分隔 IP/CIDR）。挂了 HTTPS 反代却不设置它，会让登录限流
# 退化成全局共享配额、审计日志只记代理 IP。留空 = 完全不信任 X-Forwarded-For。
# WRENCH_TRUSTED_PROXIES=172.17.0.1

# ─── 安全响应头 ───
# CSP：strict = 去掉 'unsafe-eval'（不使用插件时更严）；off = 关闭（不建议）
# WRENCH_CSP=
# HSTS：off = 不主动下发（外层代理已下发时用）；仅在请求确为 HTTPS 时生效
# WRENCH_HSTS=

# OpenRouter API Key (for AI features)
OPENROUTER_API_KEY=

# Database path (optional, falls back to in-memory database)
# In Docker: defaults to /data/wrench.db
DATABASE_URL=
