# Wrench Backend Configuration
# Copy this to .env and adjust values

# Server
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=3001
LOG_LEVEL=info

# CORS (comma-separated origins, empty = permissive)
CORS_ORIGINS=

# Frontend dist path (relative or absolute)
# In Docker: use /app/frontend/dist
FRONTEND_DIST=/app/frontend/dist

# Plugins directory
PLUGINS_DIR=./plugins

# JWT Secret (REQUIRED for production — generates random key if empty, which resets on restart)
# Generate a secure key: openssl rand -hex 32
# JWT_SECRET=

# 登录密码（必需）：任何访问端口的人都必须先登录才能调用 API / 建立 WebSocket 连接
# 未设置时后端会生成随机密码并保存到数据目录的 auth_password（查看：cat /data/auth_password）
# 生成一个强密码：openssl rand -base64 32
WRENCH_AUTH_PASSWORD=

# 也可用文件提供密码（优先级低于 WRENCH_AUTH_PASSWORD，高于自动生成）
# WRENCH_AUTH_PASSWORD_FILE=/data/auth_password

# OpenRouter API Key (for AI features)
OPENROUTER_API_KEY=

# Database path (optional, falls back to in-memory database)
# In Docker: defaults to /data/wrench.db
DATABASE_URL=
